{
  "name": "web-tutoring-framework",
  "version": "0.1.0",
  "description": "Open-source tutoring business website and management framework: marketing pages, booking requests, admin registers with lesson credits and free skips, a parent portal, Stripe payments and Gmail notifications.",
  "main": "app.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node app.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --test",
    "gmail:auth": "node scripts/gmail-oauth-setup.js"
  },
  "keywords": [
    "tutoring",
    "tutoring-management",
    "lesson-booking",
    "express",
    "ejs",
    "supabase",
    "stripe",
    "parent-portal",
    "attendance"
  ],
  "author": "Rahul Babu (https://github.com/RahulBabu06)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RahulBabu06/Web-tutoring-framework.git"
  },
  "bugs": {
    "url": "https://github.com/RahulBabu06/Web-tutoring-framework/issues"
  },
  "homepage": "https://github.com/RahulBabu06/Web-tutoring-framework#readme",
  "dependencies": {
    "body-parser": "^1.20.2",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.13"
  }
}
