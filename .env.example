# Copy to .env and fill in what you need. Every integration is optional:
# with nothing set, the public site still runs and admin/parent pages explain what's missing.
# Never commit .env.

PORT=4000

# Business settings (name, classes, prices, free skips...) live in business.config.json.
# Point BUSINESS_CONFIG at another file to keep your own copy outside the repo.
# BUSINESS_CONFIG=business.config.json

# Optional overrides of business.config.json values
# Public site URL, used for sign-up/password-reset, Stripe and email links (never taken from the Host header).
# Add <SITE_URL>/parents/reset-password to Supabase Auth > URL Configuration > Redirect URLs.
SITE_URL=http://localhost:4000
# BUSINESS_NAME=Your Tutoring Co
# CURRENCY=GBP
# LOCALE=en-GB
# TIME_ZONE=Europe/London
# Lesson pack price in minor units (pence/cents); overrides lessonPack.priceMinorUnits
# LESSON_PACK_PRICE_PENCE=18000
# 1-to-1 lesson price per length, e.g. ONE_TO_ONE_60_PRICE_PENCE=4500
# Where booking requests and local backups are saved (defaults to ./data)
# DATA_DIR=

# Admin login (required for /admin). See docs/SETUP.md, step 1.
ADMIN_PASSWORD=
# A random value of at least 32 characters, different from ADMIN_PASSWORD. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs out every admin session.
ADMIN_SESSION_SECRET=

# Supabase (database + parent accounts). See docs/SETUP.md, step 2.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Online lesson payments (Stripe Checkout). See docs/SETUP.md, step 4.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Gmail account that sends (and receives) booking emails, via the Gmail API.
# Defaults to contact.email in business.config.json. See docs/SETUP.md, step 3.
GMAIL_USER=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# Where refund-request and payment emails go (defaults to GMAIL_USER)
ADMIN_NOTIFICATION_EMAIL=
# Set to "off" to stop all automatic parent emails.
PARENT_EMAILS=on
