<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Request a Refund | <%= business.name %> Parent Portal</title>
    <link rel="stylesheet" href="/styles.css">
    <script src="/cookie-notice.js" defer></script>
</head>
<body>
    <header class="admin-header">
        <nav class="admin-nav" aria-label="Parent navigation">
            <a class="brand-link" href="/" aria-label="<%= business.name %> home"><span class="brand-wordmark"><%= business.shortName %></span></a>
            <div class="admin-nav-actions">
                <a href="/parents">Dashboard</a>
                <form action="/parents/logout" method="POST">
                    <button type="submit">Log out</button>
                </form>
            </div>
        </nav>
    </header>

    <main class="admin-page">
        <section class="admin-page-heading">
            <p class="eyebrow">Parent portal</p>
            <h1>Request a Refund</h1>
            <% if (refundable.record) { %>
                <p><%= refundable.student.name %> missed the class on <strong><%= classDateLabel %></strong> and 1 lesson was used. Tell us what happened and we'll review it.</p>
            <% } %>
        </section>

        <% if (errors.length > 0) { %>
            <div class="admin-alert">
                <% errors.forEach((error) => { %>
                    <p><%= error %></p>
                <% }) %>
            </div>
        <% } %>

        <% if (refundable.record) { %>
            <form class="admin-form" action="/parents/refunds" method="POST">
                <input type="hidden" name="attendanceId" value="<%= refundable.record.id %>">

                <label for="reason">Reason</label>
                <textarea id="reason" name="reason" rows="5" maxlength="<%= inputLimits.refundReason %>" required placeholder="For example: illness, a school trip, or a family emergency."><%= values.reason || "" %></textarea>

                <div class="form-actions">
                    <input type="submit" value="Send request">
                    <a class="secondary-link" href="/parents">Cancel</a>
                </div>
            </form>
        <% } else { %>
            <a class="button-link" href="/parents">Back to dashboard</a>
        <% } %>
    </main>
</body>
</html>
