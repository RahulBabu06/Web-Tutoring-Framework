<header class="admin-header">
    <nav class="admin-nav" aria-label="Admin navigation">
        <a class="brand-link" href="/" aria-label="<%= business.name %> home"><span class="brand-wordmark"><%= business.shortName %></span></a>
        <div class="admin-nav-actions">
            <% (locals.adminNavLinks || []).forEach((link) => { %>
                <a href="<%= link.href %>"<%- link.active ? ' aria-current="page"' : "" %>><%= link.label %><% if (link.count > 0) { %> <span class="admin-nav-count" aria-label="<%= link.count %> waiting"><%= link.count %></span><% } %></a>
            <% }) %>
            <form action="/admin/logout" method="POST">
                <button type="submit">Log out</button>
            </form>
        </div>
    </nav>
</header>
