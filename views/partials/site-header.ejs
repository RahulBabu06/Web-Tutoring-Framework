            <button class="menu-toggle" type="button" aria-controls="primary-navigation" aria-expanded="false" aria-label="Open navigation menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
            <ul id="primary-navigation" class="nav-links">
                <% [["/lessons", "Lessons"], ["/book-now", "Book now"], ["/parents/login", "Parent portal"], ["/contact", "Contact"]].forEach(([href, label]) => { %>
